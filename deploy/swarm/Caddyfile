# The only container with public HTTP ports.
#
# Two jobs: terminate TLS for the light-wallet gRPC service, and hold a
# disabled slot for the explorer. Certificates are obtained and renewed
# automatically, which needs the A records to resolve to this server and ports
# 80 and 443 to be reachable before the stack is first started.
#
# Validate a change before deploying it:
#   docker run --rm -v "$PWD/Caddyfile:/etc/caddy/Caddyfile:ro" \
#     -e SWARM_LWD_DOMAIN=lwd.example.test -e SWARM_ACME_EMAIL=ops@example.test \
#     caddy:2.11-alpine caddy validate --config /etc/caddy/Caddyfile

{
	email {$SWARM_ACME_EMAIL}

	# Production by default. Point this at Let's Encrypt's staging directory
	# while testing - staging certificates are not trusted by browsers, which
	# is the point, and its rate limits are generous where production's are
	# not. Remove the caddy_data volume when switching back, so no staging
	# certificate is kept for a name that will serve real traffic.
	acme_ca {$SWARM_ACME_CA:https://acme-v02.api.letsencrypt.org/directory}

	servers {
		# HTTP/1.1 for the ACME challenge and the redirect, HTTP/2 for gRPC.
		# HTTP/3 is left off on purpose: gRPC clients reach this over TCP, and
		# leaving it enabled would mean opening UDP/443 in the firewall for a
		# path nothing here uses.
		protocols h1 h2
	}

	# No access log is configured anywhere in this file, and that used to be
	# taken as "this server does not record who connects to it". It was not
	# true. Caddy's own runtime log attaches the full request object to some
	# entries, and the commonest of those by a wide margin is
	#
	#   warn http.handlers.reverse_proxy "aborting with incomplete response"
	#
	# which fires every time a light wallet cancels a GetBlockRange or
	# GetMempoolStream - constantly, in normal use. On 2026-09-22 that was 324
	# of the 412 lines being kept, each carrying the wallet's IP address.
	#
	# These four deletions take the address out and leave the diagnosis in:
	# upstream, method, host, uri, status, duration and the error itself all
	# survive, so a broken proxy is still debuggable. Verified against
	# caddy:2.11-alpine on exactly that entry type before it was applied.
	log {
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>client_ip delete
				request>remote_port delete
				request>headers>X-Forwarded-For delete
			}
		}
	}
}

# max-age only. No includeSubDomains, because the apex and the other
# subdomains are not this server's to speak for, and no preload, which is a
# hard-to-reverse commitment for a testnet.
(swarm_hsts) {
	header {
		Strict-Transport-Security "max-age={$SWARM_HSTS_MAX_AGE}"
		-Server
	}
}

# ---------------------------------------------------------------------------
# Light-wallet indexer: gRPC over TLS.
#
# `h2c://` makes the upstream connection plaintext HTTP/2, which is what the
# indexer serves on the internal network. Wallets get TLS; the hop between
# these two containers never leaves the host.
# ---------------------------------------------------------------------------
{$SWARM_LWD_DOMAIN} {
	import swarm_hsts

	# The public network status, as a static file. It is regenerated every 30
	# seconds by the `status` service and served from a read-only mount, so
	# this path cannot reach the node, the indexer or anything else - the worst
	# a bug here can serve is a stale copy of facts that are already public.
	#
	# Two origins may read it from a browser: the website and its www form.
	# The allowed origin is echoed rather than wildcarded, so the header names
	# exactly who may read it, and `Vary: Origin` keeps a cache from handing
	# one origin's response to another.
	handle /status.json {
		root * /srv/public
		@swarm header Origin https://swarm.green
		@www header Origin https://www.swarm.green
		header {
			Cache-Control "public, max-age=15"
			Vary "Origin"
			Content-Type "application/json; charset=utf-8"
		}
		header @swarm Access-Control-Allow-Origin "https://swarm.green"
		header @www Access-Control-Allow-Origin "https://www.swarm.green"
		file_server
	}

	# The live heat map: which nodes are connected RIGHT NOW, at city level.
	# Written by the same generator, served with a shorter cache because "live"
	# is the point, and with the same origin allow-list so it cannot become a
	# wider read surface than status.json. It contains no addresses.
	handle /swarm-map-live.json {
		root * /srv/public
		@swarm header Origin https://swarm.green
		@www header Origin https://www.swarm.green
		header {
			Cache-Control "public, max-age=5"
			Vary "Origin"
			Content-Type "application/json; charset=utf-8"
		}
		header @swarm Access-Control-Allow-Origin "https://swarm.green"
		header @www Access-Control-Allow-Origin "https://www.swarm.green"
		file_server
	}

	# Everything else on this name is the light-wallet gRPC service.
	handle {
		reverse_proxy h2c://zaino:{$SWARM_ZAINO_GRPC_PORT} {
			transport http {
				versions h2c 2
			}
			# Light wallets hold GetBlockRange and mempool streams open for a
			# long time, and buffering a stream would break them.
			flush_interval -1
		}
	}
}

# ---------------------------------------------------------------------------
# EXPLORER, INTERIM, on the light-wallet name at port 8443.
#
# explore.swarm.green has no DNS record yet and the owner wants to see the
# explorer today. This serves it on a name the server already holds a
# certificate for, on a port of its own so it cannot collide with the gRPC
# service on 443.
#
# REMOVE THIS BLOCK once explore.swarm.green is live: two public addresses for
# one service is two things to keep right, and the second one is a port people
# will paste into places it does not belong.
#
# Same hardening as the real block, including the /broadcast refusal - the
# explorer's only write path to the chain does not become reachable just
# because the door is temporary.
# ---------------------------------------------------------------------------
{$SWARM_LWD_DOMAIN}:8443 {
	import swarm_hsts
	encode zstd gzip

	handle /broadcast* {
		respond "transaction broadcast is not enabled on this server" 403
	}

	handle {
		reverse_proxy explorer:{$SWARM_EXPLORER_PORT}
	}
}

# ---------------------------------------------------------------------------
# EXPLORER - DISABLED.
#
# `explore.swarm.green` still resolves to the owner's previous site. Until that
# A record is moved to this server, serving the name here would take that site
# down and ask for a certificate for something this server does not serve, so
# the block below is commented out.
#
# To enable: move the A record, uncomment everything between the markers,
# start the service with `--profile explorer`, and reload Caddy. The CI lint
# job uncomments this block and validates it, so it is known to parse.
#
# The `/broadcast` handler is not optional. That path forwards a raw
# transaction to the node's `sendrawtransaction`, which is the explorer's only
# write path to the chain. It stays closed until there is a reason to open it,
# and it is closed here rather than in the explorer so that reading this file
# tells you the whole story of what is reachable from outside.
#
# EXPLORER-BLOCK-BEGIN
# {$SWARM_EXPLORE_DOMAIN} {
# 	import swarm_hsts
# 	encode zstd gzip
#
# 	handle /broadcast* {
# 		respond "transaction broadcast is not enabled on this server" 403
# 	}
#
# 	handle {
# 		reverse_proxy explorer:{$SWARM_EXPLORER_PORT}
# 	}
# }
# EXPLORER-BLOCK-END

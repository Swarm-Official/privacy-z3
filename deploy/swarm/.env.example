# SWARM testnet server stack - environment reference.
#
# Copy to .env on the server (scripts/deploy.sh does this for you from a local
# copy) and fill in the five values that have no sensible default. Everything
# else has one, and the defaults are sized for the rented box: 2 shared vCPUs,
# 4 GB RAM, 100 GB SSD.
#
#   docker compose --env-file .env up -d
#
# This file is a reference: every variable the stack reads appears below, with
# its default. It contains no secrets, and none belongs here - the node's RPC
# cookie is generated by the node itself, the TLS keys are held by Caddy, and
# wallet seeds and the three destination private keys must never reach this
# machine at all.

# ===========================================================================
# 1. Required. The deploy fails fast without these.
# ===========================================================================

# The server's public IPv4 address. Zebra advertises `<this>:<p2p port>` to
# peers; without it the node still dials out but accepts no inbound
# connections, which means it is not a seed. Must match the A records.
SWARM_PUBLIC_IP=

# The address the always-on baseline miner pays. Supplied at deploy time, never
# committed. A transparent testnet address (tm...) is paid as a transparent
# coinbase output; a unified address (u1...) is paid into the shielded pool.
# Rotating it is `scripts/swarm-stack rotate-miner <address>` on the server.
SWARM_MINER_ADDRESS=

# The light-wallet gRPC endpoint. Needs an A record pointing at this server
# before the first start, or Caddy cannot obtain a certificate.
SWARM_LWD_DOMAIN=lwd.swarm.green

# Where the certificate authority sends expiry and problem notices.
SWARM_ACME_EMAIL=

# The rendered configuration directory, mounted read-only into every service.
# Must contain zebrad.toml, zainod.toml, genesis.hex and manifest.json, all
# UTF-8 without a byte-order mark. Produced by workstream A's render step and
# uploaded by scripts/deploy.sh.
SWARM_CONFIG_DIR=./config/live

# ===========================================================================
# 2. Identity and ports
# ===========================================================================

# Prefixes the container, network and volume names. Changing it after the
# first deploy orphans the existing volumes, which is how you would run a
# second, separate chain on the same host on purpose.
COMPOSE_PROJECT_NAME=swarm-testnet

# Public P2P. The default testnet port; other ports work but make Zebra log
# warnings, and every wallet and node preset assumes this one.
SWARM_P2P_PORT=18233

# The node's JSON-RPC, inside the compose network only. Never published, never
# reachable from the internet, cookie-authenticated regardless.
SWARM_RPC_PORT=18232

# The indexer's gRPC, inside the compose network only. Caddy is the only
# client. Not published either: the public endpoint is TLS on 443.
SWARM_ZAINO_GRPC_PORT=8137

# ===========================================================================
# 3. Mining
# ===========================================================================

# Zebra's internal miner: one solver thread, by its design, no thread setting.
# Set to false to run a seed node that does not mine. It stays off regardless
# when SWARM_MINER_ADDRESS is empty.
SWARM_INTERNAL_MINER=true

# Block verification's rayon pool. The node is capped near one shared vCPU, so
# a larger pool only adds context switching.
SWARM_ZEBRA_RAYON_THREADS=2

# ===========================================================================
# 4. Images
#
# Built in GitHub Actions from the prebuilt binaries, exported with
# `docker save`, and installed on the server with `docker load`. Nothing here
# is built or compiled on the server. The tags must match what deploy.sh loads.
# ===========================================================================

SWARM_ZEBRA_IMAGE=swarm-zebra:local
SWARM_ZAINO_IMAGE=swarm-zaino:local
SWARM_OPS_IMAGE=swarm-ops:local

# The one upstream image the stack pulls. Pin it to a released tag; a digest
# pin is better still once the deploy has been done once.
SWARM_CADDY_IMAGE=caddy:2.10-alpine

# ===========================================================================
# 5. Resource limits
#
# Hard ceilings, sized so the baseline miner can never starve the indexer on a
# 4 GB box. With the explorer running the limits total about 2.9 GB, leaving
# the rest for the host and the 2 GB swap file provision.sh creates.
# ===========================================================================

# One of the two shared vCPUs. A slower baseline miner only means blocks
# arrive more slowly than the 75-second target until other miners join; it
# weakens nothing. Raise it if the node is the only miner and blocks stall.
SWARM_ZEBRA_CPUS=1.0
SWARM_ZEBRA_MEMORY=1g
SWARM_ZEBRA_MEMORY_RESERVATION=512m

SWARM_ZAINO_CPUS=1.0
SWARM_ZAINO_MEMORY=1g
SWARM_ZAINO_MEMORY_RESERVATION=512m

SWARM_CADDY_CPUS=0.25
SWARM_CADDY_MEMORY=128m

SWARM_OPS_CPUS=0.5
SWARM_OPS_MEMORY=128m

# ===========================================================================
# 6. Explorer slot - disabled
#
# Workstream D supplies a `docker save` tarball; deploy.sh loads it. Until
# then the service has no valid image name, is behind the `explorer` profile,
# and its Caddy block is commented out, so nothing starts and nothing is
# served.
# ===========================================================================

SWARM_EXPLORER_IMAGE=
SWARM_EXPLORER_PORT=4000
SWARM_EXPLORE_DOMAIN=explore.swarm.green
SWARM_EXPLORER_CPUS=0.5
SWARM_EXPLORER_MEMORY=768m
SWARM_EXPLORER_MEMORY_RESERVATION=256m

# ===========================================================================
# 7. Faucet slot - not built
#
# Reserved. No service, no image, no port. When it exists it is a separate
# service on the internal network behind its own Caddy block, and it holds a
# hot wallet, which is the reason it is not in this stack yet.
# ===========================================================================

# SWARM_FAUCET_DOMAIN=faucet.swarm.green

# ===========================================================================
# 8. Logs, timeouts and TLS
# ===========================================================================

# Per-service log cap: 10 MB x 5 files x 5 services is about 250 MB worst case.
SWARM_LOG_MAX_SIZE=10m
SWARM_LOG_MAX_FILES=5

SWARM_ZEBRA_LOG=info
SWARM_ZAINO_LOG=info,reqwest=warn,hyper_util=warn
RUST_BACKTRACE=1

# How long the genesis job waits for the node's RPC on a cold start.
SWARM_RPC_WAIT_SECONDS=300

# The indexer's cookie handling. It waits this long for the node's current
# cookie before giving up...
SWARM_COOKIE_WAIT_SECONDS=300
# ...re-reads it this often while running, which bounds how long a stale token
# can live after a node restart...
SWARM_COOKIE_POLL_SECONDS=5
# ...and treats an absence longer than this as a node that is not coming back
# with the same secret, and restarts to re-authenticate.
SWARM_COOKIE_MISSING_GRACE_SECONDS=120

# HSTS lifetime in seconds (one year). max-age only: no includeSubDomains and
# no preload.
SWARM_HSTS_MAX_AGE=31536000
